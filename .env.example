# Application
APP_NAME=CONSULTANT_SYSTEM
APP_ENV=development

# Server
HTTP_HOST=localhost
HTTP_PORT=8080

# Database Credentials (Required)
DB_HOST=localhost
DB_PORT=5432
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=consultation_platform
DB_SSLMODE=disable
DB_SCHEMA=consultation
DB_MAX_OPEN_CONNECTIONS=25
DB_MAX_IDLE_CONNECTIONS=5
DB_MAX_LIFETIME_MINUTES=15

# Test Database Overrides (Optional for Integration Tests)
TEST_DB_HOST=localhost
TEST_DB_PORT=5432
TEST_DB_USER=your_db_user
TEST_DB_PASSWORD=your_db_password
TEST_DB_NAME=consultation_platform_test
TEST_DB_SSLMODE=disable
TEST_DB_SCHEMA=consultation

# Redis Credentials
REDIS_ADDRESS=localhost:6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_DB=0
TEST_REDIS_DB=15
